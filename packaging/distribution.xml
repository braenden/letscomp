<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>LetsComp</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true" enable_currentUserHome="true"/>
    <allowed-os-versions>
        <os-version min="12.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="clap"/>
    </choices-outline>
    <choice id="au" title="Audio Unit" description="For Logic Pro, GarageBand, Ableton Live and other hosts that use Audio Units.">
        <pkg-ref id="io.github.braenden.letscomp.au"/>
    </choice>
    <choice id="vst3" title="VST3" description="For FL Studio, Ableton Live, Cubase, Reaper, Studio One and most other hosts.">
        <pkg-ref id="io.github.braenden.letscomp.vst3"/>
    </choice>
    <choice id="clap" title="CLAP" description="For Bitwig Studio, Reaper and other hosts that support CLAP.">
        <pkg-ref id="io.github.braenden.letscomp.clap"/>
    </choice>
    <pkg-ref id="io.github.braenden.letscomp.au" version="@VERSION@" onConclusion="none">LetsComp-au.pkg</pkg-ref>
    <pkg-ref id="io.github.braenden.letscomp.vst3" version="@VERSION@" onConclusion="none">LetsComp-vst3.pkg</pkg-ref>
    <pkg-ref id="io.github.braenden.letscomp.clap" version="@VERSION@" onConclusion="none">LetsComp-clap.pkg</pkg-ref>
</installer-gui-script>
